# =============================================================================
# 复制为 .env 后填写密钥。不要把填好的 .env 提交到 git。
# 引擎选型（jsonl / ES / Qdrant / Milvus）在 config/rag.yaml，连接串放这里。
# =============================================================================

# ----- 硅基流动：BGE-M3 嵌入 + bge-reranker 重排 -----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 限流按模型/接口在代码里传 RateBudget，不走环境变量

# ----- 生成 LLM（默认 DeepSeek；接口 OpenAI 兼容） -----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选备用（教程阶段 8 或中文生成对比时再填）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# ----- 解析插件（parser.backend=llamaparse / unstructured 云时填写） -----
LLAMA_CLOUD_API_KEY=
UNSTRUCTURED_API_URL=
UNSTRUCTURED_API_KEY=

# ----- 向量库：Qdrant（默认 vector.backend=qdrant） -----
# 本机 Docker 请用 127.0.0.1，避免 macOS 代理把 localhost 转走导致 502
QDRANT_URL=http://127.0.0.1:6333
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_rag
QDRANT_API_KEY=

# ----- 向量库：Milvus（vector.backend=milvus 时填写） -----
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=enterprise_rag
MILVUS_TOKEN=

# ----- 稀疏索引：Elasticsearch（sparse.backend=elasticsearch 时填写） -----
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=rag_chunks
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# ----- MySQL：入库账本 kb_document / kb_ingest_job（ledger.backend=mysql） -----
# 本机已有 Docker MySQL 时改账号密码即可；先迁移：uv run python scripts/init_mysql.py
MYSQL_DSN=mysql://root:password@127.0.0.1:3306/rag_hub
# LEDGER_BACKEND=mysql
# RAG_TENANT_ID=default

# ----- Postgres：FTS / pgvector（sparse.backend=postgres_fts 或 vector.backend=pgvector） -----
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/rag
POSTGRES_FTS_TABLE=rag_chunks
PGVECTOR_TABLE=rag_embeddings

# ----- Neo4j（阶段 8 GraphRAG 可选） -----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ----- Langfuse（推荐云免费档；自托管见 README「单独 Docker」） -----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_HOST=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-sandbox
# LANGFUSE_SECRET_KEY=sk-lf-local-sandbox

# ----- 应用 -----
RAG_CONFIG=config/rag.yaml
EMBED_DIM=1024
